# only key needed: answer generation (Claude). Vector DB + embeddings are keyless/local.
ANTHROPIC_API_KEY=sk-ant-...
# optional: point at a Qdrant server for production scale (docker run -p 6333:6333 qdrant/qdrant)
# unset = embedded local mode, stored under data/qdrant
QDRANT_URL=
QDRANT_COLLECTION=rag
# optional: gate mutating/LLM endpoints on a public deployment
DEMO_TOKEN=
# optional: answer model override
ANSWER_MODEL=claude-opus-5
