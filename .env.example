# answer generation (Claude). Vector DB + embeddings are keyless/local.
# with an API key (sk-ant-api...): answers go through the Anthropic SDK.
# without one: answers go through the local `claude` CLI (subscription auth).
# force with ANSWER_BACKEND=sdk|cli
ANTHROPIC_API_KEY=
ANSWER_BACKEND=
# optional: point at a Qdrant server for production scale (docker run -p 6333:6333 qdrant/qdrant)
# unset = embedded local mode, stored under data/qdrant
QDRANT_URL=
QDRANT_COLLECTION=rag
# optional: gate mutating/LLM endpoints on a public deployment
DEMO_TOKEN=
# optional: answer model override (SDK backend)
ANSWER_MODEL=claude-opus-5
